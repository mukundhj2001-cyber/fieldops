# TYPESAFE_API_KEY=
# TYPESAFE_API_URL=https://api.typesafe.ai
# TYPESAFE_MODEL=jev-latest
# JEV_PROVIDER=typesafe

# Optional: show collapsed "Dev details" on the voice page (default off)
# NEXT_PUBLIC_SHOW_DEBUG=1

# Twilio Voice (inbound phone path — separate from the web demo UI)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...
# Public HTTPS origin Twilio can reach (ngrok / cloudflared / deployed host)
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
# Set the number's Voice webhook to: {PUBLIC_BASE_URL}/api/twilio/voice  (POST)
